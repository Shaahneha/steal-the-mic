# Secrets
.env

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Local data — ignore the WHOLE directory, not just data/*.json.
#
# data/cache/ holds full transcripts of whatever talk was analysed. Those are
# the speaker's/publisher's copyrighted words, and for TED/TEDx material the
# licence forbids redistributing derivatives at all. An earlier `data/*.json`
# rule did not match `data/cache/*.json`, which would have committed a 232 KB
# TED transcript and contradicted this repo's own claim to contain none.
# Everything under data/ is regenerated by ingest.py + analyze_talk.py anyway.
data/

# Local Claude Code / editor config — machine-specific, not project config.
.claude/

# Personal notes / scratch
notes*.md
scratch*.md
*.local.md

# Internal working notes — build log and testing aid, not part of the
# submission. Kept locally.
DESIGN_DECISIONS.md
TESTING_GUIDE.md
